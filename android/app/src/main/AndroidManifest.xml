<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The app talks to the Express backend over HTTP, so it needs INTERNET. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      The gym reminder is a local notification. On Android 13+ posting any
      notification requires this runtime permission; on older versions it is
      granted at install time, so the app asks for it only when the user turns
      the reminder on. Notifications are scheduled with WorkManager, which needs
      no other permission and survives a reboot by itself.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Importing a reminder sound means copying the chosen file into the phone's
      shared sound library, which is how Android lets another app's sound be
      played by the system. From Android 10 that copy needs no permission; only
      Android 9 and older require this one, so it is capped at API 28 and asked
      for at the moment the user reaches for a sound.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!--
      The camera: NOTHING here. A profile picture is taken by the phone's camera
      app, which writes the file through the FileProvider below. Declaring
      android.permission.CAMERA would make Android demand that permission before
      the camera app may even be asked, which would break the flow for no gain.
    -->

    <application
        android:name=".RepRiseApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RepRise">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.RepRise"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The camera needs somewhere to write the photo it takes, and Android
          will not hand a plain file:// path to another app. This provider turns
          the one file into a content:// URI that is granted, per launch, to
          whichever camera app handles the request.

          `res/xml/file_paths.xml` limits it to the `cache/avatar/` directory, so
          the camera is given access to nothing else in the app.

          Note there is deliberately NO android.permission.CAMERA above: the
          photo is taken by the phone's camera app, not by this one. Declaring
          the permission would actually BREAK the flow, because Android then
          requires it to be granted before the camera intent may be sent.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
