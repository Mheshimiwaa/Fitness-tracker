<?xml version="1.0" encoding="utf-8"?>
<!--
  A bathroom-scale glyph, used for the body-weight metric.

  Drawn as strokes rather than a filled silhouette so it reads clearly at small
  sizes. `Icon(painter = ..., tint = ...)` recolours the whole painter, so the
  literal white here becomes the theme's accent colour at runtime.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Scale body -->
    <path
        android:pathData="M6,3 L18,3 A3,3 0 0 1 21,6 L21,18 A3,3 0 0 1 18,21 L6,21 A3,3 0 0 1 3,18 L3,6 A3,3 0 0 1 6,3 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:fillColor="#00000000" />

    <!-- Display window -->
    <path
        android:pathData="M8,8.5 L16,8.5"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />

    <!-- Needle -->
    <path
        android:pathData="M12,12.5 L12,16"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
</vector>
