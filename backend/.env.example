# ---------------------------------------------------------------------------
# RepRise backend — environment variables
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is git-ignored and must NEVER be committed to GitHub.
# This example file contains placeholders only — no real secrets.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=4000

# MongoDB connection string.
# Local MongoDB (running on this machine):
#   mongodb://127.0.0.1:27017/reprise
# MongoDB Atlas (replace user, password and cluster host):
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/reprise

# Logical database name inside the MongoDB deployment.
MONGODB_DB_NAME=reprise

# Secret used to sign JWTs. Must be long and random.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# How long issued tokens stay valid (jsonwebtoken duration format).
JWT_EXPIRES_IN=7d

# bcrypt cost factor (10 is a good default for local development).
BCRYPT_ROUNDS=10

# Comma-separated list of allowed CORS origins, or `*` for local development.
CORS_ORIGIN=*

# Development-only HTTP request logging (method, route, status, duration, request id).
ENABLE_HTTP_LOGS=true

# Where uploaded profile pictures are written. Git-ignored; keep it on a volume
# that survives a redeploy. Omit it to use the default, `backend/uploads`
# (resolved from the project, not the working directory, so `npm start` from
# anywhere finds the same folder).
#UPLOADS_DIR=/var/lib/reprise/uploads

# Largest accepted profile-picture body, in bytes (default: 5 MB). A picture is
# downscaled to a 512-pixel JPEG by the app before it is sent, so this is only a
# ceiling, not a target.
#PHOTO_MAX_BYTES=5242880
